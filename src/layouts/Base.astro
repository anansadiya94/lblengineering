---
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/500.css';
import '@fontsource/ibm-plex-sans-hebrew/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, intlPhone, type Lang } from '../lib/content';
import { path, otherLang, ui, type PageKey } from '../lib/i18n';

interface Props {
  lang: Lang;
  pageKey: PageKey | null; // null for pages without a translation (404)
  title: string;
  description: string;
}

const { lang, pageKey, title, description } = Astro.props;
const t = ui[lang];
const base = site.site_url;
const dir = lang === 'he' ? 'rtl' : 'ltr';
const canonical = pageKey ? base + path(lang, pageKey) : undefined;
const ogImage = `${base}/og-image.jpg`;
const c = site.company;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${base}/#business`,
  name: c.name[lang],
  alternateName: c.name[otherLang(lang)],
  description: c.tagline[lang],
  url: base + path(lang, 'home'),
  logo: `${base}/icon-512.png`,
  image: ogImage,
  telephone: intlPhone(c.phone),
  faxNumber: intlPhone(c.fax),
  email: c.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.address.street[lang],
    addressLocality: c.address.city[lang],
    addressCountry: c.address.country,
    ...(c.address.postal_code ? { postalCode: c.address.postal_code } : {}),
  },
  areaServed: 'IL',
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      pageKey && (
        <>
          <link rel="alternate" hreflang="he" href={base + path('he', pageKey)} />
          <link rel="alternate" hreflang="en" href={base + path('en', pageKey)} />
          <link rel="alternate" hreflang="x-default" href={base + path('he', pageKey)} />
        </>
      )
    }
    {pageKey === null && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'he' ? 'en_US' : 'he_IL'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#393536" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
