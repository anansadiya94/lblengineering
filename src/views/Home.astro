---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import ProjectStrip from '../components/ProjectStrip.astro';
import { img, page, site, telHref, type Lang, type PageBase } from '../lib/content';
import { path, ui } from '../lib/i18n';

interface HomeData extends PageBase {
  hero_title: string;
  hero_text: string;
  hero_cta: string;
  services_title: string;
  services: { title: string; text: string; image: string; image_alt: string }[];
  about_title: string;
  about_text: string;
  about_image_alt: string;
  about_facts: { label: string; value: string }[];
  about_link: string;
  projects_title: string;
  projects_link: string;
  contact_title: string;
  contact_cta: string;
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = page<HomeData>(lang, 'home');
const t = ui[lang];
const c = site.company;
const home = site.home;

const preview = home.projects_preview.map((src) => site.projects.find((p) => p.src === src)!);
---

<Base lang={lang} pageKey="home" title={data.seo_title} description={data.seo_description}>
  <Sheet lang={lang} size="hero" labelledby="hero-title">
    <h1 id="hero-title">{data.hero_title}</h1>
    <p class="hero-text">{data.hero_text}</p>
    <div class="hero-actions">
      <a class="button" href={path(lang, 'contact')}>{data.hero_cta}</a>
      <a class="hero-phone" href={telHref(c.phone)}>{t.phone} <span dir="ltr">{c.phone}</span></a>
    </div>
    <Image
      slot="photo"
      src={img(home.hero_image)}
      alt=""
      widths={[480, 800, 1100]}
      sizes="(min-width: 800px) 55vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </Sheet>

  <section id="services" class="wrap services" aria-labelledby="services-title">
    <h2 id="services-title">{data.services_title}</h2>
    <ul class="schedule">
      {
        data.services.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <Image src={img(s.image)} alt={s.image_alt} widths={[240, 400, 560]} sizes="(min-width: 800px) 22vw, 100vw" />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" class="about-teaser on-dark" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="about-text">
        <h2 id="about-title">{data.about_title}</h2>
        <p class="lead">{data.about_text}</p>
        <dl class="facts">
          {
            data.about_facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="about-more"><a href={path(lang, 'about')}>{data.about_link}</a></p>
      </div>
      <figure class="about-photo">
        <Image src={img(home.about_image)} alt={data.about_image_alt} widths={[480, 780]} sizes="(min-width: 800px) 45vw, 100vw" />
      </figure>
    </div>
  </section>

  <section id="projects" class="projects-preview" aria-labelledby="projects-title">
    <div class="wrap section-head">
      <h2 id="projects-title">{data.projects_title}</h2>
      <a href={path(lang, 'projects')}>{data.projects_link}</a>
    </div>
    <ProjectStrip lang={lang} projects={preview} />
  </section>

  <section id="contact" class="wrap talk" aria-labelledby="contact-title">
    <h2 id="contact-title">{data.contact_title}</h2>
    <p class="talk-phone"><a href={telHref(c.phone)} dir="ltr">{c.phone}</a></p>
    <p class="talk-email"><a href={`mailto:${c.email}`}>{c.email}</a></p>
    <a class="button" href={path(lang, 'contact')}>{data.contact_cta}</a>
  </section>
</Base>
