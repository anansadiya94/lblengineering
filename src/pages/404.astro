---
import Base from '../layouts/Base.astro';
import { path, ui } from '../lib/i18n';
const he = ui.he;
const en = ui.en;
---

<Base lang="he" pageKey={null} title={`${he.not_found_title} | ${en.not_found_title}`} description={he.not_found_text}>
  <section class="wrap page-head not-found">
    <h1>{he.not_found_title}</h1>
    <p class="lead">{he.not_found_text}</p>
    <p><a class="button" href={path('he', 'home')}>{he.not_found_back}</a></p>
    <div lang="en" dir="ltr" class="not-found-en">
      <h2>{en.not_found_title}</h2>
      <p>{en.not_found_text}</p>
      <p><a href={path('en', 'home')}>{en.not_found_back}</a></p>
    </div>
  </section>
</Base>
