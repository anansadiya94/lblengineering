---
import { Image } from 'astro:assets';
import { img, telHref, type Lang, type TeamMember } from '../lib/content';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
  member: TeamMember;
  headingLevel?: 'h3' | 'h4';
  showPhoto?: boolean;
  delay?: number; // entrance stagger in ms
}

const { lang, member, headingLevel = 'h3', showPhoto = true, delay = 0 } = Astro.props;
const t = ui[lang];
const Heading = headingLevel;
// Initials for members without a photo: "Eng. Luai Otter" → "LO".
const initials = member.name[lang]
  .replace(/^(אינג'|Eng\.)\s*/, '')
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2);
---

<article class="member" data-reveal style={`--delay: ${delay}ms`}>
  {
    showPhoto &&
      (member.photo ? (
        <Image class="member-photo" src={img(member.photo)} alt={member.name[lang]} width={200} height={200} />
      ) : (
        <div class="member-photo member-initials" aria-hidden="true">{initials}</div>
      ))
  }
  <Heading class="member-name">{member.name[lang]}</Heading>
  <p class="member-role">{member.role[lang]}</p>
  <ul class="member-links">
    {member.phone && <li>{t.phone}: <a href={telHref(member.phone)} dir="ltr">{member.phone}</a></li>}
    {member.email && <li>{t.email}: <a href={`mailto:${member.email}`}>{member.email}</a></li>}
  </ul>
</article>
