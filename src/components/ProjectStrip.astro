---
// A sideways-scrolling strip of project photos with previous/next buttons.
import { Image } from 'astro:assets';
import { img, type Lang, type Project } from '../lib/content';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = ui[lang];
---

<div class="strip-wrap" data-strip>
  <ul class="strip" tabindex="0" aria-label={t.strip_label}>
    {
      projects.map((p) => (
        <li class="strip-item">
          <figure>
            <Image src={img(p.src)} alt={p.alt[lang]} widths={[480, 800, 1200]} sizes="(min-width: 800px) 73vw, 80vw" />
            {p.title?.[lang] && <figcaption>{p.title[lang]}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
  <div class="wrap strip-controls">
    <button type="button" class="icon-button" data-dir="prev">
      <svg aria-hidden="true" class="flip-rtl" width="20" height="20" viewBox="0 0 20 20"><path d="M13 3 6 10l7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <span>{t.strip_prev}</span>
    </button>
    <button type="button" class="icon-button" data-dir="next">
      <span>{t.strip_next}</span>
      <svg aria-hidden="true" class="flip-rtl" width="20" height="20" viewBox="0 0 20 20"><path d="m7 3 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((wrap) => {
    const strip = wrap.querySelector<HTMLElement>('.strip')!;
    const rtl = getComputedStyle(strip).direction === 'rtl';
    wrap.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = strip.querySelector<HTMLElement>('.strip-item');
        const step = (item?.offsetWidth ?? 300) + 20;
        const forward = btn.dataset.dir === 'next' ? 1 : -1;
        // In RTL the strip scrolls towards negative scrollLeft.
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        strip.scrollBy({ left: step * forward * (rtl ? -1 : 1), behavior: still ? 'auto' : 'smooth' });
      });
    });
  });
</script>
