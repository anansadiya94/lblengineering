---
// Laid out like the title block in the corner of an engineering drawing:
// the firm in the large cell, contact details in the small ones.
import { site, telHref, type Lang } from '../lib/content';
import { path, ui, type PageKey } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = site.company;
const links: PageKey[] = ['home', 'about', 'projects', 'contact', 'accessibility'];
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="wrap title-block">
    <div class="tb-firm">
      <p class="tb-name">{c.name[lang]}</p>
      <p class="tb-tagline">{c.tagline[lang]}</p>
    </div>
    <address class="tb-contact">
      <p><span class="tb-label">{t.address}</span>{c.address.street[lang]}, {c.address.city[lang]}</p>
      <p><span class="tb-label">{t.phone}</span><a href={telHref(c.phone)} dir="ltr">{c.phone}</a></p>
      <p><span class="tb-label">{t.email}</span><a href={`mailto:${c.email}`}>{c.email}</a></p>
      <p><span class="tb-label">{t.fax}</span><span dir="ltr">{c.fax}</span></p>
    </address>
    <nav class="tb-nav" aria-label={t.footer_menu}>
      <ul>
        {links.map((key) => <li><a href={path(lang, key)}>{t[key]}</a></li>)}
      </ul>
    </nav>
    <p class="tb-legal">© {year} {c.name[lang]}. {t.rights}.</p>
  </div>
</footer>
